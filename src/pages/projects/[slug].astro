---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cv, getProjectBySlug } from '../../data/cv';
import { withBase } from '../../utils/withBase';

export function getStaticPaths() {
  return cv.projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug as string);

if (!project) {
  throw new Error(`Project not found: ${slug}`);
}

const imageSrc = withBase(project.image);
const homeHref = withBase('/');
---

<BaseLayout
  title={`${project.title} · ${cv.profile.name}`}
  description={project.summary}
>
  <article class="pb-24 pt-32 md:pt-40">
    <div class="section-shell">
      <a
        href={homeHref}
        class="mb-8 inline-flex items-center gap-2 text-sm text-[var(--text-muted)] transition hover:text-[var(--text)]"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        Volver al inicio
      </a>

      <header
        class="surface-card overflow-hidden"
        transition:name={`project-${project.slug}`}
      >
        <div
          class="relative aspect-[21/9] min-h-[220px] overflow-hidden"
          style={`background: linear-gradient(145deg, ${project.accent}40, transparent 55%);`}
        >
          <img
            src={imageSrc}
            alt={`Vista previa de ${project.title}`}
            class="h-full w-full object-cover"
          />
        </div>

        <div class="p-6 md:p-10">
          <p class="font-mono text-xs text-[var(--accent)]">{project.year}</p>
          <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-5xl">
            {project.title}
          </h1>
          <p class="mt-4 max-w-3xl text-lg text-[var(--text-muted)]">
            {project.description}
          </p>

          <div class="mt-6 flex flex-wrap gap-2">
            {project.stack.map((tech) => <span class="tech-badge">{tech}</span>)}
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            {
              project.demoUrl && (
                <a
                  href={project.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 3h6v6"></path>
                    <path d="M10 14 21 3"></path>
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  </svg>
                  Ver demo
                </a>
              )
            }
            {
              project.repoUrl && (
                <a
                  href={project.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-secondary"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                    <path d="M9 18c-4.51 2-5-2-7-2"></path>
                  </svg>
                  Repositorio
                </a>
              )
            }
          </div>
        </div>
      </header>

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <section class="surface-card reveal p-6">
          <h2 class="text-lg font-semibold">Problema</h2>
          <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">
            {project.sections.problem}
          </p>
        </section>
        <section class="surface-card reveal p-6">
          <h2 class="text-lg font-semibold">Solución</h2>
          <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">
            {project.sections.solution}
          </p>
        </section>
        <section class="surface-card reveal p-6 md:col-span-2">
          <h2 class="text-lg font-semibold">Arquitectura</h2>
          <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">
            {project.sections.architecture}
          </p>
        </section>
      </div>

      <section class="surface-card reveal mt-5 p-6 md:p-8">
        <h2 class="text-lg font-semibold">Highlights</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            project.sections.highlights.map((item) => (
              <li class="flex gap-3 rounded-xl border border-[var(--border)] bg-[var(--bg-soft)] p-4 text-sm text-[var(--text-muted)]">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[var(--success)]" />
                {item}
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>
