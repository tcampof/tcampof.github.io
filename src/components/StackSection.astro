---
import SpotlightCard from './SpotlightCard';
import { cv } from '../data/cv';
---

<section id="stack" class="scroll-mt-28 py-20 md:py-28">
  <div class="section-shell">
    <div class="reveal mb-10 max-w-2xl">
      <p class="eyebrow mb-3">Stack & metodología</p>
      <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">
        Herramientas con criterio
      </h2>
      <p class="mt-3 text-[var(--text-muted)]">
        Badges basados en experiencia aplicada — no en barras de porcentaje arbitrarias.
      </p>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
      {
        cv.skills.map((category) => (
          <div class="reveal">
            <SpotlightCard client:visible as="article" className="surface-card h-full p-6">
              <h3 class="text-lg font-semibold text-[var(--text)]">{category.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">
                {category.description}
              </p>
              <div class="mt-5 flex flex-wrap gap-2">
                {category.skills.map((skill) => (
                  <span class="tech-badge">{skill}</span>
                ))}
              </div>
            </SpotlightCard>
          </div>
        ))
      }
    </div>

    <div class="reveal mt-10 grid gap-4 md:grid-cols-3">
      {
        cv.methodology.map((item) => (
          <article class="rounded-2xl border border-[var(--border)] bg-[color-mix(in_srgb,var(--bg-elevated)_70%,transparent)] p-5">
            <h3 class="font-semibold text-[var(--text)]">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">
              {item.description}
            </p>
          </article>
        ))
      }
    </div>

    <div class="reveal mt-14">
      <p class="eyebrow mb-3">Formación & certificaciones</p>
      <div class="grid gap-4 md:grid-cols-3">
        {
          cv.education.map((item) => (
            <article class="surface-card p-5">
              <p class="font-mono text-xs text-[var(--accent)]">{item.year}</p>
              <h3 class="mt-2 font-semibold text-[var(--text)]">{item.title}</h3>
              <p class="mt-1 text-sm text-[var(--text-muted)]">{item.institution}</p>
              <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">{item.details}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
