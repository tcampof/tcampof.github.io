---
import { cv } from '../data/cv';

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border)] py-10">
  <div
    class="section-shell flex flex-col items-start justify-between gap-4 text-sm text-[var(--text-muted)] sm:flex-row sm:items-center"
  >
    <p>
      © {year}
      <span class="text-[var(--text)]"> {cv.profile.name}</span>
      · Currículum interactivo
    </p>
    <p class="font-mono text-xs">
      Hecho con Astro · TypeScript · Tailwind
    </p>
  </div>
</footer>
