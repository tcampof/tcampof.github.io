---
import ProjectCard from './ProjectCard';
import { cv } from '../data/cv';
import { withBase } from '../utils/withBase';

const projects = cv.projects;
---

<section id="proyectos" class="scroll-mt-28 py-20 md:py-28">
  <div class="section-shell">
    <div class="reveal mb-10 max-w-2xl">
      <p class="eyebrow mb-3">Proyectos destacados</p>
      <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">
        Productos con impacto medible
      </h2>
      <p class="mt-3 text-[var(--text-muted)]">
        Selección de trabajos donde he liderado o contribuido de punta a punta: desde el problema
        de negocio hasta la arquitectura y el delivery.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {
        projects.map((project, index) => (
          <div class={`reveal ${index === 0 ? 'md:col-span-2' : ''}`}>
            <ProjectCard
              client:visible
              project={project}
              href={withBase(`/projects/${project.slug}/`)}
              imageSrc={withBase(project.image)}
              large={index === 0}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
