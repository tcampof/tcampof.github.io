---
import { cv } from '../data/cv';
import { withBase } from '../utils/withBase';

const { profile } = cv;
const pdfHref = withBase(profile.cvPdfPath);
const photoSrc = withBase(profile.photoPath);
---

<section class="relative overflow-hidden pb-16 pt-32 md:pb-24 md:pt-40">
  <div class="section-shell">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(260px,0.85fr)] lg:gap-14">
      <div class="reveal max-w-3xl">
        {
          profile.available && (
            <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-[color-mix(in_srgb,var(--success)_35%,var(--border))] bg-[color-mix(in_srgb,var(--success)_10%,transparent)] px-3 py-1.5 text-sm text-[var(--success)]">
              <span class="availability-dot" aria-hidden="true" />
              <span class="font-medium">{profile.availabilityLabel}</span>
            </div>
          )
        }

        <p class="eyebrow mb-4">{profile.title}</p>

        <h1 class="text-4xl font-semibold tracking-tight text-[var(--text)] sm:text-5xl md:text-6xl lg:text-7xl">
          <span class="gradient-text">{profile.name}</span>
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--text-muted)] md:text-xl">
          {profile.headline}
        </p>

        <div class="mt-4 flex items-center gap-2 text-sm text-[var(--text-muted)]">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>{profile.location}</span>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#contacto" class="btn btn-primary">
            Hablemos
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 13 6-6"></path>
              <path d="M15 13V7H9"></path>
              <path d="M21 21H3"></path>
            </svg>
          </a>
          <a href={pdfHref} class="btn btn-secondary" download>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 15V3"></path>
              <path d="m7 10 5 5 5-5"></path>
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            </svg>
            Descargar CV
          </a>
        </div>
      </div>

      <div class="reveal relative mx-auto w-full max-w-[340px] lg:mx-0 lg:ml-auto lg:max-w-none">
        <div
          aria-hidden="true"
          class="hero-photo-glow pointer-events-none absolute left-1/2 top-[28%] h-[48%] w-[100%] -translate-x-1/2"
        ></div>
        <div class="hero-photo-fade relative z-10 mx-auto w-full max-w-[340px] lg:max-w-none">
          <img
            src={photoSrc}
            alt={`Foto de ${profile.name}`}
            class="relative mx-auto h-auto w-full object-contain drop-shadow-[0_18px_40px_rgba(0,0,0,0.28)]"
            width="1086"
            height="1372"
            loading="eager"
            decoding="async"
            transition:name="profile-photo"
          />
        </div>
      </div>
    </div>
  </div>
</section>
