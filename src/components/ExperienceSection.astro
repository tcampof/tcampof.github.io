---
import Timeline from './Timeline';
import { cv } from '../data/cv';
---

<section id="experiencia" class="scroll-mt-28 py-20 md:py-28">
  <div class="section-shell">
    <div class="reveal mb-12 max-w-2xl">
      <p class="eyebrow mb-3">Trayectoria profesional</p>
      <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">
        Experiencia con foco en producto
      </h2>
      <p class="mt-3 text-[var(--text-muted)]">
        Roles donde he combinado delivery técnico, colaboración con producto y mejora continua
        de sistemas.
      </p>
    </div>

    <div class="reveal">
      <Timeline client:visible items={cv.experience} />
    </div>
  </div>
</section>
